{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bell-county-articles schema",
  "type": "object",
  "properties": {
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_articles": {
      "type": "integer"
    },
    "by_relevance": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/article"
          }
        },
        "high": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/article"
          }
        },
        "medium": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/article"
          }
        },
        "low": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/article"
          }
        }
      }
    }
  },
  "definitions": {
    "article": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "keyword_count": {
          "type": "integer"
        },
        "relevance": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "matched_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Bell County court",
              "District Court",
              "County Court at Law",
              "Belton",
              "Temple",
              "Killeen"
            ]
          }
        }
      },
      "required": [
        "title",
        "date",
        "source",
        "url",
        "path",
        "score",
        "keyword_count",
        "relevance"
      ]
    }
  }
}