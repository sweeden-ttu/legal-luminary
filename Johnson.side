        {
          "id": "0dde622f-f898-4a1f-9a8d-ed595aa302ee",
          "comment": "",
          "command": "executeScript",
          "target": "var f = document.getElementById('SearchCriteria_DateFrom');\nvar t = document.getElementById('SearchCriteria_DateTo');\nif (f) { f.value = '05/13/2026'; $(f).trigger('change'); }\nif (t) { t.value = '06/13/2026'; $(t).trigger('change'); }\nreturn 'Dates set: 05/13/2026 - 06/13/2026';",
          "targets": [],
          "value": ""
        },
        {
          "id": "ee0e49e1-ec1d-4efb-aff8-6ac6163e8e5f",
          "comment": "",
